RecipeBuilder.get("carpenter")
	.setShaped([
		[wwPlank, wwPlank, wwPlank],
		[weedwood, syrmoriteIngot, weedwood],
		[weedwood, weedwood, weedwood]])
	.addOutput(<thebetweenlands:weedwood_chest>)
	.addTool(<ore:artisansHammer>, 10)
	.create();




